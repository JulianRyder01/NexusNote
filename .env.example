# 环境变量示例：复制为 .env 后按需修改

# 访问密码（首次启动时写入数据库）
APLUSNEXUS_PASSWORD=aplusnexus

# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# 会话有效期（天）
SESSION_DAYS=30

# 后端监听
PORT=3001
HOST=127.0.0.1

# SQLite 数据库文件路径（相对仓库根）
DATABASE_PATH=data/aplusnexus.db

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info
